ARG APT_MIRROR=https://mirrors.aliyun.com
ARG UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple
ARG UV_PYTHON_INSTALL_MIRROR=https://registry.npmmirror.com/-/binary/python-build-standalone

FROM ghcr.io/astral-sh/uv:0.11.25 AS uv

FROM python:3.12-slim-bookworm AS runtime-builder

ARG UV_DEFAULT_INDEX

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}

WORKDIR /build

COPY runtime/pyproject.toml runtime/uv.lock runtime/README.md ./
RUN uv export \
        --frozen \
        --no-dev \
        --no-emit-project \
        --format requirements-txt \
        --output-file /requirements.txt

COPY runtime/src ./src
COPY runtime/examples ./examples

RUN --mount=type=cache,target=/root/.cache/uv \
    uv build --wheel --out-dir /dist

FROM apache/dolphinscheduler-standalone-server:3.2.2

USER root

ARG APT_MIRROR
ARG UV_DEFAULT_INDEX
ARG UV_PYTHON_INSTALL_MIRROR

# Support Debian/Ubuntu images using either deb822 or traditional apt source files.
RUN set -eux; \
    mirror="${APT_MIRROR%/}"; \
    for source_file in \
        /etc/apt/sources.list \
        /etc/apt/sources.list.d/*.list \
        /etc/apt/sources.list.d/*.sources; \
    do \
        [ -f "${source_file}" ] || continue; \
        sed -i \
            -e "s|http://deb.debian.org/debian-security|${mirror}/debian-security|g" \
            -e "s|https://deb.debian.org/debian-security|${mirror}/debian-security|g" \
            -e "s|http://security.debian.org/debian-security|${mirror}/debian-security|g" \
            -e "s|https://security.debian.org/debian-security|${mirror}/debian-security|g" \
            -e "s|http://deb.debian.org/debian|${mirror}/debian|g" \
            -e "s|https://deb.debian.org/debian|${mirror}/debian|g" \
            -e "s|http://archive.ubuntu.com/ubuntu|${mirror}/ubuntu|g" \
            -e "s|https://archive.ubuntu.com/ubuntu|${mirror}/ubuntu|g" \
            -e "s|http://security.ubuntu.com/ubuntu|${mirror}/ubuntu|g" \
            -e "s|https://security.ubuntu.com/ubuntu|${mirror}/ubuntu|g" \
            -e "s|http://ports.ubuntu.com/ubuntu-ports|${mirror}/ubuntu-ports|g" \
            -e "s|https://ports.ubuntu.com/ubuntu-ports|${mirror}/ubuntu-ports|g" \
            "${source_file}"; \
    done

RUN apt-get update \
    && apt-get install -y --no-install-recommends psmisc \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/arena-runtime/python \
    UV_PYTHON_INSTALL_MIRROR=${UV_PYTHON_INSTALL_MIRROR} \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    VIRTUAL_ENV=/opt/arena-runtime/.venv

RUN mkdir -p /opt/arena-runtime/wheels \
    && uv python install 3.12 \
    && uv venv --python 3.12 "${VIRTUAL_ENV}"

COPY --from=runtime-builder /requirements.txt /opt/arena-runtime/requirements.txt

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_NO_CACHE=0 uv pip install \
        --python "${VIRTUAL_ENV}/bin/python" \
        --requirements /opt/arena-runtime/requirements.txt

COPY --from=runtime-builder /dist/arena_runtime-*.whl /opt/arena-runtime/wheels/

RUN uv pip install \
        --python "${VIRTUAL_ENV}/bin/python" \
        --no-deps \
        /opt/arena-runtime/wheels/arena_runtime-*.whl \
    && "${VIRTUAL_ENV}/bin/python" --version \
    && "${VIRTUAL_ENV}/bin/core-manage" --help \
    && "${VIRTUAL_ENV}/bin/core-manage" apps factor --help \
    && "${VIRTUAL_ENV}/bin/core-manage" messages send --help

# Python Task builds `${PYTHON_LAUNCHER} generated_script.py` and executes it
# through a tenant login shell, so the launcher must live in the task env file.
RUN printf '\nexport PYTHON_LAUNCHER="%s"\n' "${VIRTUAL_ENV}/bin/python" \
        >> /opt/dolphinscheduler/conf/dolphinscheduler_env.sh \
    && sed -i \
        's|^shell.env_source_list=.*$|shell.env_source_list=/opt/dolphinscheduler/conf/dolphinscheduler_env.sh|' \
        /opt/dolphinscheduler/conf/common.properties

RUN printf '%s\n' \
        'Defaults env_keep += "PROD ARENA_SHARED_CLOUD DATA_START_DATE INDEX_CODES TUSHARE_TOKEN"' \
        'Defaults env_keep += "DOLPHIN_HOST DOLPHIN_PORT DOLPHIN_USERNAME DOLPHIN_PASSWORD"' \
        'Defaults env_keep += "DOLPHIN_CORE_DATABASE DOLPHIN_CORE_TABLE DOLPHIN_DIVIDEND_TABLE"' \
        'Defaults env_keep += "OBJECT_STORAGE_ACCESS_KEY_ID OBJECT_STORAGE_SECRET_ACCESS_KEY"' \
        'Defaults env_keep += "OBJECT_STORAGE_ENDPOINT_URL OBJECT_STORAGE_BUCKET OBJECT_STORAGE_REGION"' \
        'Defaults env_keep += "OBJECT_STORAGE_ADDRESSING_STYLE OBJECT_STORAGE_ROOT_FOLDER"' \
        > /etc/sudoers.d/arena-runtime-env \
    && chmod 0440 /etc/sudoers.d/arena-runtime-env \
    && visudo -cf /etc/sudoers.d/arena-runtime-env

ENV PATH="/opt/arena-runtime/.venv/bin:${PATH}"
