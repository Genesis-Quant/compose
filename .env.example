# Shared storage
ARENA_SHARED_DIR=./shared
ARENA_SHARED_CLOUD=false
COMPOSE_NETWORK_NAME=arena-network

# Published host bindings
BACKEND_BIND_IP=127.0.0.1
BACKEND_BIND_PORT=8000
DOLPHINSCHEDULER_BIND_IP=127.0.0.1
DOLPHINSCHEDULER_API_BIND_PORT=12345
DOLPHINSCHEDULER_PYTHON_GATEWAY_BIND_PORT=25333

# Docker build mirrors
APT_MIRROR=https://mirrors.aliyun.com
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple
UV_PYTHON_INSTALL_MIRROR=https://registry.npmmirror.com/-/binary/python-build-standalone

# PostgreSQL
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=postgres
PGSQL_PASSWORD=replace-with-a-random-password
ARENA_DATABASE=arena_runtime
DOLPHINSCHEDULER_DATABASE=dolphinscheduler

# Authentication
ARENA_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ARENA_JWT_EXPIRE_DAYS=30
# Public backend origin used in MCP protected-resource metadata and Host validation.
ARENA_PUBLIC_URL=http://127.0.0.1:8000
ARENA_WEB_URL=http://127.0.0.1:5173

# DolphinDB
#
# 单节点模式只需填写 DOLPHIN_HOST 和 DOLPHIN_PORT，并保持
# DOLPHIN_HIGH_AVAILABILITY_SITES 为空、DOLPHIN_USE_PUBLIC_NAME=false。
#
# 集群模式下，DOLPHIN_HOST:DOLPHIN_PORT 是首次连接的数据节点或计算节点；
# DOLPHIN_HIGH_AVAILABILITY_SITES 使用逗号列出可接入的数据节点和计算节点，
# 不要填写 controller 或 agent。通过公网访问且集群已配置 publicName 时，
# 才将 DOLPHIN_USE_PUBLIC_NAME 改为 true。公网模式下普通 Session 会按公网入口
# 依次尝试初始连接，连接池则通过 publicName 使用集群高可用，避免比较内网 site。
DOLPHIN_HOST=127.0.0.1
DOLPHIN_PORT=8848
DOLPHIN_HIGH_AVAILABILITY_SITES=
DOLPHIN_USE_PUBLIC_NAME=false

# 业务运行账号用于 Query、Factor、Backtest、参数调优和 MCP，只授予读取数据库
# 与执行脚本所需权限；Worker 账号用于初始化表和增量写入，两组凭据不要共用。
DOLPHIN_RUNTIME_USERNAME=arena_runtime
DOLPHIN_RUNTIME_PASSWORD=change-me
DOLPHIN_WORKER_USERNAME=arena_worker
DOLPHIN_WORKER_PASSWORD=change-me
DOLPHIN_CORE_DATABASE=dfs://CoreData
DOLPHIN_CORE_TABLE=coreData
DOLPHIN_DIVIDEND_TABLE=stockDividend

# Market data
INDEX_CODES=000016.SH,000300.SH,000905.SH,000852.SH
DATA_START_DATE=2010-01-01
TUSHARE_TOKEN=replace-with-your-tushare-token

# S3-compatible object storage.
# Keep the bucket in OBJECT_STORAGE_BUCKET; do not include it in the endpoint URL.
OBJECT_STORAGE_ENDPOINT_URL=https://cos.ap-nanjing.myqcloud.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
OBJECT_STORAGE_BUCKET=replace-with-bucket-name
OBJECT_STORAGE_REGION=ap-nanjing
OBJECT_STORAGE_ADDRESSING_STYLE=virtual
OBJECT_STORAGE_ROOT_FOLDER=arena-runtime

# DolphinScheduler
DOLPHINSCHEDULER_HOST=127.0.0.1
DOLPHINSCHEDULER_PYTHON_GATEWAY_TOKEN=replace-with-a-random-token
DOLPHINSCHEDULER_USERNAME=arena-scheduler
DOLPHINSCHEDULER_PASSWORD=change-me
DOLPHINSCHEDULER_PROJECT_NAME=arena-runtime
DOLPHINSCHEDULER_WORKER_GROUP=default
DOLPHINSCHEDULER_TENANT_CODE=default
DOLPHINSCHEDULER_POLL_INTERVAL_SECONDS=5
DOLPHINSCHEDULER_POLL_BATCH_SIZE=100
DOLPHINSCHEDULER_QUERY_TASK_GROUP_SIZE=1
DOLPHINSCHEDULER_FACTOR_TASK_GROUP_SIZE=1
DOLPHINSCHEDULER_BACKTEST_TASK_GROUP_SIZE=1
DOLPHINSCHEDULER_OPTIMIZATION_TASK_GROUP_SIZE=1
DOLPHINSCHEDULER_SENSITIVITY_TASK_GROUP_SIZE=1
