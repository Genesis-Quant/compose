# Shared storage
ARENA_SHARED_HOST_DIR=D:/Docker/arena/shared

# PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_USER=arena
POSTGRES_PASSWORD=replace-with-a-random-password
DOLPHINSCHEDULER_POSTGRES_DB=dolphinscheduler
DATABASE_URL=postgresql://127.0.0.1:5432/dolphinscheduler

# DolphinDB
DOLPHIN_HOST=127.0.0.1
DOLPHIN_PORT=8848
DOLPHIN_USERNAME=admin
DOLPHIN_PASSWORD=change-me
DOLPHIN_CORE_DATABASE=dfs://CoreData
DOLPHIN_CORE_TABLE=coreData
DOLPHIN_DIVIDEND_TABLE=stockDividend

# Market data
INDEX_CODES=000016.SH,000300.SH,000905.SH,000852.SH
DATA_START_DATE=2010-01-01
TUSHARE_TOKEN=replace-with-your-tushare-token

# S3-compatible object storage.
# Keep the bucket in OBJECT_STORAGE_BUCKET; do not include it in the endpoint URL.
OBJECT_STORAGE_ENDPOINT_URL=https://cos.ap-nanjing.myqcloud.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
OBJECT_STORAGE_BUCKET=replace-with-bucket-name
OBJECT_STORAGE_REGION=ap-nanjing
OBJECT_STORAGE_ADDRESSING_STYLE=virtual
OBJECT_STORAGE_ROOT_FOLDER=arena-runtime

# DolphinScheduler
DOLPHINSCHEDULER_BASE_URL=http://127.0.0.1:12345/dolphinscheduler
DOLPHINSCHEDULER_PYTHON_GATEWAY_ADDRESS=127.0.0.1
DOLPHINSCHEDULER_PYTHON_GATEWAY_PORT=25333
DOLPHINSCHEDULER_PYTHON_GATEWAY_AUTH_TOKEN=replace-with-a-random-token
DOLPHINSCHEDULER_USERNAME=arena-scheduler
DOLPHINSCHEDULER_PASSWORD=change-me
DOLPHINSCHEDULER_PROJECT_NAME=arena-runtime
DOLPHINSCHEDULER_WORKFLOW_NAME=incremental-update
DOLPHINSCHEDULER_QUERY_WORKFLOW_NAME=query
DOLPHINSCHEDULER_FACTOR_WORKFLOW_NAME=factor
DOLPHINSCHEDULER_BACKTEST_WORKFLOW_NAME=backtest
DOLPHINSCHEDULER_INCREMENTAL_TASK_GROUP_NAME=tushare-api
DOLPHINSCHEDULER_INCREMENTAL_TASK_GROUP_SIZE=1
DOLPHINSCHEDULER_WORKER_GROUP=default
DOLPHINSCHEDULER_TENANT_CODE=default
DOLPHINSCHEDULER_RUNTIME_COMMAND=/opt/arena-runtime/.venv/bin/core-manage
