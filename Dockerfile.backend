ARG UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple

FROM ghcr.io/astral-sh/uv:0.11.25 AS uv

FROM python:3.12-slim-bookworm AS runtime-builder

ARG UV_DEFAULT_INDEX

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}

WORKDIR /build/backend

COPY backend/pyproject.toml backend/uv.lock ./
COPY runtime/pyproject.toml runtime/uv.lock runtime/README.md /build/runtime/

RUN uv export \
        --frozen \
        --no-dev \
        --no-emit-project \
        --no-emit-package arena-runtime \
        --format requirements-txt \
        --output-file /requirements.txt

WORKDIR /build/runtime

COPY runtime/src ./src
COPY runtime/examples ./examples

RUN --mount=type=cache,target=/root/.cache/uv \
    uv build --wheel --out-dir /dist

FROM python:3.12-slim-bookworm AS builder

ARG UV_DEFAULT_INDEX

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN uv venv --python /usr/local/bin/python "${VIRTUAL_ENV}"

COPY --from=runtime-builder /requirements.txt /requirements.txt

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_NO_CACHE=0 uv pip install \
        --python "${VIRTUAL_ENV}/bin/python" \
        --requirements /requirements.txt

COPY --from=runtime-builder /dist/arena_runtime-*.whl /wheels/

RUN uv pip install \
        --python "${VIRTUAL_ENV}/bin/python" \
        --no-deps \
        /wheels/arena_runtime-*.whl

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

COPY backend/core ./core
COPY backend/config.py ./config.py
COPY backend/main.py ./main.py
COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000"]
