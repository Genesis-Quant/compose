PROD=true
PGSQL_HOST=host.docker.internal
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/dolphinscheduler
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-a-random-password
DOLPHIN_HOST=host.docker.internal
DOLPHINSCHEDULER_BASE_URL=http://dolphinscheduler-standalone:12345/dolphinscheduler
DOLPHINSCHEDULER_PYTHON_GATEWAY_ADDRESS=dolphinscheduler-standalone
DOLPHINSCHEDULER_RUNTIME_COMMAND=/opt/arena-runtime/.venv/bin/core-manage
ARENA_SHARED_DIR=/shared
