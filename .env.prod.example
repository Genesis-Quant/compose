# Load this file after .env:
# docker compose --env-file .env --env-file .env.prod up -d
PROD=true
ARENA_PUBLIC_URL=https://api.example.com
ARENA_WEB_URL=https://example.com
COMPOSE_NETWORK_NAME=arena-prod-network
ARENA_SHARED_DIR=/shared
ARENA_SHARED_CLOUD=false

# Published host bindings. Use 0.0.0.0 only when external access is required.
BACKEND_BIND_IP=127.0.0.1
BACKEND_BIND_PORT=8000
DOLPHINSCHEDULER_BIND_IP=127.0.0.1
DOLPHINSCHEDULER_API_BIND_PORT=12345
DOLPHINSCHEDULER_PYTHON_GATEWAY_BIND_PORT=25333

PGSQL_HOST=postgresql
DOLPHINSCHEDULER_HOST=dolphinscheduler-standalone

# DolphinDB 默认继承 .env。生产环境连接不同节点时，只取消所需覆盖项的注释；
# 节点列表只包含 data node / compute node，不包含 controller / agent。公网模式下
# 普通 Session 按这些入口依次尝试，连接池通过 publicName 使用集群高可用。
# DOLPHIN_HOST=replace-with-dolphindb-host
# DOLPHIN_PORT=8848
# DOLPHIN_HIGH_AVAILABILITY_SITES=host1:port,host2:port
# DOLPHIN_USE_PUBLIC_NAME=false
